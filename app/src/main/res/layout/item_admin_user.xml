<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/admin_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/admin_dot_offline" />

        <TextView
            android:id="@+id/txt_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:text="email@exemplo.com"
            android:textColor="@color/launcher_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_status_label"
            android:fontFamily="@font/montserrat_medium"
            android:text="offline"
            android:textColor="@color/launcher_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/montserrat_medium"
        android:text="uid • IP • última vez visto"
        android:textColor="@color/launcher_text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txt_ban_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/montserrat_medium"
        android:text="Banido: motivo"
        android:textColor="@color/launcher_danger"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_ban_ip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/admin_btn_danger"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Banir IP"
            android:textColor="@color/launcher_danger"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_toggle_ban"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/admin_btn_danger"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Banir conta"
            android:textColor="@color/launcher_danger"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
