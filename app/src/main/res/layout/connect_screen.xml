<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background art -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_connect"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trocar de conta (Google account switch pill, top-left) -->
    <LinearLayout
        android:id="@+id/btn_switch_account"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_google" />

        <TextView
            android:id="@+id/txt_switch_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Trocar de conta"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <!-- Bottom bar: socials (left) + server box + atualizar button (right) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Social icons -->
        <ImageView
            android:id="@+id/btn_discord"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_dark"
            android:padding="14dp"
            android:src="@drawable/ic_discord"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_tiktok"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_dark"
            android:padding="14dp"
            android:src="@drawable/ic_tiktok"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_youtube"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_dark"
            android:padding="14dp"
            android:src="@drawable/ic_youtube"
            android:clickable="true"
            android:focusable="true" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Server info box: name (top) + real player count (bottom) -->
        <LinearLayout
            android:id="@+id/panel_server"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_server_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Consultando servidor..."
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_people" />

                    <TextView
                        android:id="@+id/txt_server_slots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="--/--"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_tap_hand"
                app:tint="#2E9BF6" />
        </LinearLayout>

        <!-- "Instalação necessária" + Baixar button, stacked so the label
             always sits directly above the button regardless of screen
             width (a ConstraintLayout constraint pointing at btn_atualizar
             wouldn't work reliably since the button lives inside this
             LinearLayout, not as a direct child of the root). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/txt_install_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Instalação necessária"
                android:textColor="#FFC94D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="1" />

            <!-- Atualizar/Baixar button -->
            <LinearLayout
                android:id="@+id/btn_atualizar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_blue"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_refresh" />

                <TextView
                    android:id="@+id/txt_atualizar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="BAIXAR"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
